                if y + height &gt; screen.Y - 8 then y = math.max(8, origin.Y - height) end
                menu.Position = UDim2.fromOffset(math.clamp(origin.X, 8, math.max(8, screen.X - size.X - 8)), y)
                menu.Size = UDim2.fromOffset(size.X, height)
