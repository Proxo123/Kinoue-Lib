        U.label(c.Row, info.Text or id, { Size = UDim2.new(1, -85, 1, 0) })
        c.Root = U.button(c.Row, "", { Position = UDim2.new(1, -30, 0, 4), Size = UDim2.fromOffset(28, 15) })
        ColorPicker.attach(self, c, info)
        return c
    end
    function group:AddPreview(info)
        info = info or {}
        local preview = {}
        preview.Root = U.frame(self.Container, { Size = UDim2.new(1, 0, 0, info.Height or 148), BorderColor3 = T.Outline, BorderSizePixel = 1, ClipsDescendants = true })
        local grid = U.frame(preview.Root, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 1 })
        local gridDots = {}
        local gridColumns, gridRows = -1, -1
        local drawing = U.frame(preview.Root, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 2 })
        preview.Points = {}; preview.Parts = {}
        local count = self:AddLabel("0 / 0")
        local track = U.frame(self.Container, { Size = UDim2.new(1, 0, 0, 3), BackgroundColor3 = T.Hover })
        local fill = U.frame(track, { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.Accent })
        local function layout()
            local bounds = preview.Root.AbsoluteSize
            local columns = math.max(0, math.floor((bounds.X - 16) / 10) + 1)
            local rows = math.max(0, math.floor((bounds.Y - 16) / 10) + 1)
            if columns ~= gridColumns or rows ~= gridRows then
                for key, dot in pairs(gridDots) do
                    if dot.Position.X.Offset &gt; bounds.X - 8 or dot.Position.Y.Offset &gt; bounds.Y - 8 then dot:Destroy(); gridDots[key] = nil end
                end
                for y = 8, bounds.Y - 8, 10 do for x = 8, bounds.X - 8, 10 do
                    local key = x .. ":" .. y
                    if not gridDots[key] then gridDots[key] = U.frame(grid, { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(1, 1), BackgroundColor3 = T.Outline, BackgroundTransparency = 0.35 }) end
                end end
                gridColumns, gridRows = columns, rows
            end
            local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
            for _, point in ipairs(preview.Points) do minX = math.min(minX, point.X); minY = math.min(minY, point.Y); maxX = math.max(maxX, point.X); maxY = math.max(maxY, point.Y) end
            if #preview.Points == 0 then return end
            local size = preview.Root.AbsoluteSize
            local cell = math.min((size.X - 24) / (maxX - minX + 1), (size.Y - 24) / (maxY - minY + 1))
            cell = math.max(1, cell)
            local ox, oy = (size.X - (maxX - minX + 1) * cell) / 2, (size.Y - (maxY - minY + 1) * cell) / 2
            for i, point in ipairs(preview.Points) do
                preview.Parts[i].Position = UDim2.fromOffset(ox + (point.X - minX) * cell, oy + (point.Y - minY) * cell)
                preview.Parts[i].Size = UDim2.fromOffset(cell * 0.84, cell * 0.84)
            end
        end
        function preview:SetPoints(points)
            for _, part in ipairs(self.Parts) do part:Destroy() end
            self.Points = table.clone(points); self.Parts = {}
            for _, _point in ipairs(points) do
                local part = U.frame(drawing, { BackgroundColor3 = T.Accent })
                U.new("UICorner", { CornerRadius = UDim.new(0, 1) }, part)
                table.insert(self.Parts, part)
            end
            layout(); self:SetCount(0, #points)
        end
        function preview:SetCount(current, total)
            count:SetText(string.format("%d / %d", current, total))
            fill.Size = UDim2.fromScale(total &gt; 0 and math.clamp(current / total, 0, 1) or 0, 1)
        end
        function preview:Recoil()
            if group.Window.ReducedMotion then return end
            group.Window.Scope:Tween(drawing, 0.06, { Position = UDim2.fromOffset(-3, -2) }, false)
            task.delay(0.06, function() if not group.Window.Dead then group.Window.Scope:Tween(drawing, 0.19, { Position = UDim2.fromOffset(0, 0) }, false) end end)
        end
        group.Window.Scope:Connect(preview.Root:GetPropertyChangedSignal("AbsoluteSize"), layout)
        preview:SetPoints(info.Points or {})
        return preview
    end
end
return Controls

end
__factories["Window"] = function()
local U = __require("internal/Util")
local T = __require("internal/Theme")
local Controls = __require("Controls")
local Mount = __require("internal/Mount")
local Fade = __require("internal/Fade")
local Cursor = __require("internal/Cursor")
local Input = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Http = game:GetService("HttpService")
local Window = {}
Window.__index = Window

function Window.new(options)
    local self = setmetatable({}, Window)
    self.Scope = U.scope()
    self.Controls = {}; self.Pages = {}; self.Keybinds = {}
    self.Cleanup = {}
    self.ReducedMotion = options.ReducedMotion == true
    self.ToggleKey = options.ToggleKey or Enum.KeyCode.RightShift
    self.Size = options.Size or Vector2.new(704, 470)
    self.MinSize = options.MinSize or Vector2.new(480, 360)
    self.Resizable = options.Resizable ~= false
    self.Open = true; self.Dead = false; self.VisibilityVersion = 0
    self.Screen = U.new("ScreenGui", {
        Name = options.Id or "BoogaUI", ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = options.DisplayOrder or 100,
    })
    Mount.core(self.Screen)
    local initialPosition = options.Position or UDim2.fromScale(0.5, 0.5)
    self.Root = U.new("Frame", {
        Name = "Window", AnchorPoint = Vector2.new(0, 0),
        Position = UDim2.new(initialPosition.X.Scale, initialPosition.X.Offset - self.Size.X / 2, initialPosition.Y.Scale, initialPosition.Y.Offset - self.Size.Y / 2),
        Size = UDim2.fromOffset(self.Size.X, self.Size.Y), BackgroundColor3 = T.Background,
        BorderColor3 = T.Outline, BorderSizePixel = 1, ClipsDescendants = true,
    }, self.Screen)
    self.RestPosition = self.Root.Position
    self.Header = U.frame(self.Root, { Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = T.Panel, Active = true })
    U.label(self.Header, options.Name or "BOOGA", { Position = UDim2.fromOffset(8, 0), Size = UDim2.new(0.45, -8, 1, 0), TextSize = T.TextSize + 1 })
    U.label(self.Header, "PlaceId: " .. tostring(options.PlaceId or game.PlaceId), {
        Position = UDim2.new(0.45, 0, 0, 0), Size = UDim2.new(0.55, -8, 1, 0),
        TextColor3 = T.Muted, TextSize = T.SmallSize, TextXAlignment = Enum.TextXAlignment.Right,
    })
    U.frame(self.Header, { Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = T.Outline })
    local accent = U.frame(self.Root, { Name = "RainbowAccent", Position = UDim2.fromOffset(0, 31), Size = UDim2.fromOffset(364, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 4 })
    self.Accent = accent
    local transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.12, 0), NumberSequenceKeypoint.new(0.88, 0), NumberSequenceKeypoint.new(1, 1) })
    local gradient = U.new("UIGradient", { Transparency = transparency }, accent)
    local hues, last = {}, -1
    self.Scope:Connect(RunService.RenderStepped, function()
        if not self.Open then return end
        local tick = self.ReducedMotion and 0 or math.floor(os.clock() * 30)
        if tick == last then return end
        last = tick
        local phase = self.ReducedMotion and 0 or (tick / 150) % 1
        for i = 0, 6 do
            hues[i + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV((i / 6 + phase) % 1, 0.56, 0.93))
        end
        gradient.Color = ColorSequence.new(hues)
    end)
    self.Tabs = U.new("ScrollingFrame", { Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 0, 30), BorderSizePixel = 0, BackgroundColor3 = T.Background, ScrollBarThickness = 0, AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.X }, self.Root)
    U.padding(self.Tabs, 4); U.list(self.Tabs, true, 0)
