local Model = require("../src/internal/Model")
local calls = 0
local c = Model.control(5, function(value) return Model.number(value, 0, 20, 0.5) end, function() calls += 1 end)
assert(c:Get() == 5)
c:Set(40); assert(c:Get() == 20 and calls == 1)
c:Set(20); assert(calls == 1, "Unchanged values must not repeat callbacks")
c:SetSilent(7.3); assert(c:Get() == 7.5 and calls == 1)
c:Set(0 / 0); assert(c:Get() == 0 and calls == 2)
assert(Model.number(math.huge, 0, 20, 1) == 0)
local options = Model.options({ "Bluefruit", { Value = "Wood", Label = "Wood", Meta = 180 } })
assert(options[1].Label == "Bluefruit" and options[2].Meta == 180)
assert(not pcall(Model.options, { "Wood", "Wood" }), "Duplicate values must be rejected")
print("PASS: normalization, bounds, step precision, non-finite values, callback suppression, silent updates, option validation")
