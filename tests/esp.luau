local target = Mock:AddPlayer("Target")
local highlight = target.Character:WaitForChild("KinoueESP")
assert(highlight.Adornee == target.Character and highlight.Enabled)
local selfHighlight = Mock.Players.LocalPlayer.Character:WaitForChild("KinoueESP")
assert(not selfHighlight.Enabled)
window.Controls.SelfPreview:Set(true)
assert(selfHighlight.Enabled)
window.Controls.ESPColor:Set(Mock.Environment.Color3.fromRGB(255, 0, 0))
assert(highlight.FillColor:ToHex() == "FF0000" and highlight.OutlineColor:ToHex() == "FF0000")
window.Controls.FillTransparency:Set(30)
assert(highlight.FillTransparency == 0.3)
window.Controls.ThroughWalls:Set(false)
assert(highlight.DepthMode == Mock.Enum.HighlightDepthMode.Occluded)
window.Controls.ESP:Set(false)
assert(not highlight.Enabled and not selfHighlight.Enabled)
window.Controls.ESP:Set(true)
Mock:Respawn(target)
assert(highlight.Destroyed)
local respawned = target.Character:WaitForChild("KinoueESP")
assert(respawned.Enabled and respawned.FillColor:ToHex() == "FF0000")
Mock:RemovePlayer(target)
assert(respawned.Destroyed)
local second = Mock:AddPlayer("Second")
local secondHighlight = second.Character:WaitForChild("KinoueESP")
window.Controls.ESPColor.Root.Activated:Fire()
assert(window.PopupOwner == window.Controls.ESPColor)
window:Destroy()
window:Destroy()
Mock:Advance(1)
assert(secondHighlight.Destroyed and selfHighlight.Destroyed)
assert(Mock:ConnectionCount() == 0 and next(Mock.Run.Bindings) == nil)
print("PASS: ESP colors, toggles, fill transparency, self preview, player joins/leaves, respawns, and unload cleanup")
